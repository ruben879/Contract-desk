# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Contract reading
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5

# Inbound email. The forward-to address shown in the app; {token} is filled per brokerage/agent.
# Quick start with Postmark's built-in address (Postmark > Inbound stream > Settings):
#   INBOUND_ADDRESS_TEMPLATE=abc123def+{token}@inbound.postmarkapp.com
# Later, with MX records on your own subdomain:
#   INBOUND_ADDRESS_TEMPLATE=contracts+{token}@inbound.yourdomain.com
INBOUND_ADDRESS_TEMPLATE=
# Webhook password. Postmark webhook URL: https://postmark:THIS_VALUE@your-app.vercel.app/api/inbound/email
INBOUND_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
